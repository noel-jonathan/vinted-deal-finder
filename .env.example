# Google Gemini API Key (Get a free API key at: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="your_gemini_api_key_here"

# Model identifier (default is gemini-3.6-flash; supports gemini-3.8-flash, gemini-3.6-flash, etc.)
GEMINI_MODEL="gemini-3.6-flash"

# Optional Vinted regional domain (e.g. vinted.co.uk, vinted.fr, vinted.de, vinted.com)
VINTED_DOMAIN="vinted.co.uk"

# AI Studio App Hosting URL
APP_URL="MY_APP_URL"

